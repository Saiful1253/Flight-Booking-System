@model FlightBookingSystem.Models.Booking
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "E-ticket";
    var f = Model.Flight!;
    string Money(decimal v) => $"BDT {v:N0}";
    string Dur(int m) => m >= 60 ? $"{m / 60}h {m % 60:D2}m" : $"{m}m";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 no-print">
    <a class="btn btn-soft btn-sm" asp-action="MyBookings"><i class="bi bi-arrow-left"></i> My bookings</a>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-soft btn-sm" onclick="printTicket()"><i class="bi bi-printer"></i> Print ticket</button>
        @if (Model.IsActive && f.DepartureAt > DateTime.UtcNow)
        {
            <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit passengers</a>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Cancel this booking? Seats will be released.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-soft btn-sm text-danger"><i class="bi bi-x-circle"></i> Cancel booking</button>
            </form>
        }
    </div>
</div>

@if (Model.Status == BookingStatus.Pending)
{
    <div class="note-box mb-3 no-print">
        <i class="bi bi-hourglass-split"></i> <b>Awaiting verification.</b> Our admin team verifies the payment and
        confirms your booking — you will see the status change here.
    </div>
}
else if (Model.Status == BookingStatus.Rejected)
{
    <div class="alert-app err no-print"><i class="bi bi-x-octagon-fill"></i>
        Booking rejected — @(Model.RejectionReason ?? "no reason given"). Seats have been released.
    </div>
}
else if (Model.Status == BookingStatus.Cancelled)
{
    <div class="alert-app err no-print"><i class="bi bi-slash-circle"></i> This booking was cancelled. It stays here for your records.</div>
}

<div class="ticket">
    <div class="ticket-head">
        <div>
            <div class="brandline"><i class="bi bi-airplane-engines-fill"></i> FLYLOCAL E-TICKET</div>
            <div class="small opacity-75">@f.Airline!.Name · @f.FlightNumber · @(f.AircraftType ?? "Standard aircraft")</div>
        </div>
        <div class="text-end">
            <div class="small opacity-75">Booking reference (PNR)</div>
            <div class="pnr">@Model.Pnr</div>
            <partial name="_BookingBadge" model="Model.Status" />
        </div>
    </div>

    <div class="ticket-body">
        <div>
            <div class="ticket-route mb-4">
                <div>
                    <div class="code">@f.DepartureAirport!.Code</div>
                    <div class="city">@f.DepartureAirport.City</div>
                    <div class="fw-bold mt-1">@f.DepartureAt.ToString("HH:mm")</div>
                    <div class="city">@f.DepartureAt.ToString("ddd, dd MMM yyyy")</div>
                </div>
                <div class="fc-line">
                    <div class="dur">@Dur(f.DurationMinutes) · Non-stop</div>
                    <div class="track"><i class="bi bi-airplane"></i></div>
                </div>
                <div class="text-end">
                    <div class="code">@f.ArrivalAirport!.Code</div>
                    <div class="city">@f.ArrivalAirport.City</div>
                    <div class="fw-bold mt-1">@f.ArrivalAt.ToString("HH:mm")</div>
                    <div class="city">@f.ArrivalAt.ToString("ddd, dd MMM yyyy")</div>
                </div>
            </div>

            <h6 class="text-uppercase text-muted-2 small fw-bold">Passengers</h6>
            @foreach (var p in Model.Passengers.OrderBy(p => p.SeatNumber))
            {
                <div class="passenger-row">
                    <span><b>@p.FullName</b><span class="table-sub ms-2">@p.Age · @p.Gender · @p.IdType ****@p.IdNumber[^Math.Min(4, p.IdNumber.Length)..]</span></span>
                    <span class="seat-chip">Seat @(p.SeatNumber ?? "—")</span>
                </div>
            }
        </div>

        <div class="ticket-meta">
            <div class="kv"><span class="k">Cabin class</span><span class="v">@Model.CabinClass</span></div>
            <div class="kv"><span class="k">Passengers</span><span class="v">@Model.PassengerCount</span></div>
            <div class="kv"><span class="k">Total paid</span><span class="v">@Money(Model.TotalPrice)</span></div>
            <div class="kv"><span class="k">Payment ref</span><span class="v">@(Model.PaymentRef ?? "—")</span></div>
            <div class="kv"><span class="k">Card</span><span class="v">•••• @(Model.CardLast4 ?? "—")</span></div>
            <div class="kv"><span class="k">Contact</span><span class="v">@Model.ContactEmail<br />@(Model.ContactPhone ?? "")</span></div>
            <div class="kv"><span class="k">Booked on</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span></div>
            @if (Model.VerifiedAt != null)
            {
                <div class="kv"><span class="k">Verified</span><span class="v">@Model.VerifiedAt.Value.ToString("dd MMM, HH:mm")</span></div>
            }
        </div>
    </div>

    <div class="ticket-perf"></div>
    <div class="barcode"></div>
</div>

<p class="small text-muted-2 mt-3 no-print">
    <i class="bi bi-info-circle"></i> Arrive at the airport at least 2 hours before departure and carry the same
    ID used for this booking.
</p>
