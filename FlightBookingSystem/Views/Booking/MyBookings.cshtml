@model List<FlightBookingSystem.Models.Booking>
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "My bookings";
    var current = ViewBag.StatusFilter as string;
    string cls(string? s) => current == s ? "btn-accent" : "btn-soft";
}

<div class="d-flex gap-2 flex-wrap mb-3">
    <a class="btn btn-sm @cls(null)" asp-action="MyBookings">All</a>
    <a class="btn btn-sm @cls("Pending")" asp-action="MyBookings" asp-route-status="Pending">Pending</a>
    <a class="btn btn-sm @cls("Confirmed")" asp-action="MyBookings" asp-route-status="Confirmed">Confirmed</a>
    <a class="btn btn-sm @cls("Cancelled")" asp-action="MyBookings" asp-route-status="Cancelled">Cancelled</a>
    <a class="btn btn-sm @cls("Rejected")" asp-action="MyBookings" asp-route-status="Rejected">Rejected</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-ticket-perforated"></i>
            <h5>No bookings here</h5>
            <p>Search a route and book a flight to see it here.</p>
            <a class="btn btn-accent btn-sm" asp-controller="Home" asp-action="Index">Search flights</a>
        </div>
    }
    else
    {
        <table class="table table-clean">
            <thead>
                <tr>
                    <th>PNR</th><th>Flight</th><th>Route</th><th>Departure</th>
                    <th>Class</th><th>Pax</th><th>Total</th><th>Status</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var f = b.Flight!;
                    <tr>
                        <td class="table-title">@b.Pnr
                            @if (b.DuplicateOfId != null) { <span class="pill-dup ms-1"><i class="bi bi-files"></i> dup of #@b.DuplicateOfId</span> }
                        </td>
                        <td>@f.FlightNumber <div class="table-sub">@f.Airline!.Name</div></td>
                        <td>@f.DepartureAirport!.Code → @f.ArrivalAirport!.Code</td>
                        <td>@f.DepartureAt.ToString("dd MMM yyyy, HH:mm")</td>
                        <td><span class="cls-chip @b.CabinClass.ToString().ToLower()">@b.CabinClass</span></td>
                        <td>@b.PassengerCount</td>
                        <td class="fw-bold">BDT @b.TotalPrice.ToString("N0")</td>
                        <td><partial name="_BookingBadge" model="b.Status" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-soft btn-xs" asp-action="Ticket" asp-route-id="@b.Id"><i class="bi bi-ticket-detail"></i> Ticket</a>
                            @if (b.IsActive && f.DepartureAt > DateTime.UtcNow)
                            {
                                <a class="btn btn-soft btn-xs" asp-action="Edit" asp-route-id="@b.Id"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="Cancel" asp-route-id="@b.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel booking @b.Pnr? Seats will be released.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-soft btn-xs text-danger"><i class="bi bi-x-circle"></i> Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
