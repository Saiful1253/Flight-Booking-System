<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FlyLocal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<div class="auth-shell" data-auth-role="@(((string?)ViewData["AuthRole"]) ?? "client")">
    <aside class="auth-visual">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <span class="logo-mark"><i class="bi bi-airplane-engines-fill"></i></span>
            <span class="brand-txt">FlyLocal<em>Flight Booking</em></span>
        </a>

        <div class="auth-copy">
            <span class="auth-kicker"><i class="bi bi-geo-alt-fill"></i> Dhaka · Chattogram · Sylhet · Dubai</span>
            <h2 id="authTitle">@ViewData["AuthTitle"]</h2>
            <p id="authSub">@ViewData["AuthSub"]</p>
            <ul class="auth-points">
                <li><i class="bi bi-check-circle-fill"></i> Search flights across Bangladesh &amp; international routes</li>
                <li><i class="bi bi-check-circle-fill"></i> Instant seat assignment with e-ticket &amp; PNR</li>
                <li><i class="bi bi-check-circle-fill"></i> Free cancellation and easy booking updates</li>
            </ul>
        </div>

        <!-- Boarding-pass decoration -->
        <div class="boarding-pass" aria-hidden="true">
            <div class="bp-head">
                <span class="bp-title"><i class="bi bi-airplane-fill"></i> BOARDING PASS</span>
                <span class="bp-class">ECONOMY</span>
            </div>
            <div class="bp-route">
                <div class="bp-end"><b>DAC</b><span>Dhaka</span></div>
                <div class="bp-mid"><span class="bp-line"></span><i class="bi bi-airplane"></i><span class="bp-line"></span></div>
                <div class="bp-end ta-r"><b>CGP</b><span>Chattogram</span></div>
            </div>
            <div class="bp-meta">
                <div><span>PASSENGER</span><b>FLYLOCAL GUEST</b></div>
                <div><span>GATE</span><b>A2</b></div>
                <div><span>SEAT</span><b>1A</b></div>
                <div><span>PNR</span><b>FLY7SKY</b></div>
            </div>
            <div class="bp-barcode"></div>
        </div>
    </aside>

    <main class="auth-panel">
        <a class="auth-back" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to site</a>
        <div class="auth-card">
            @RenderBody()
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
