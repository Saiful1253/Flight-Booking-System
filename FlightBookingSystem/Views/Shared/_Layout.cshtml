<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - FlyLocal | Flight Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="public-body">
    <nav class="public-nav">
        <div class="public-nav-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <span class="logo-mark"><i class="bi bi-airplane-engines-fill"></i></span>
                <span class="logo-text">FlyLocal<em>Flight Booking</em></span>
            </a>
            <button class="public-nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div class="public-links">
                <a asp-controller="Home" asp-action="Index">Search flights</a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Client" asp-action="Index">My dashboard</a>
                    <a asp-controller="Booking" asp-action="MyBookings">My bookings</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">@Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-soft btn-sm ms-2">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-accent btn-sm ms-2">Create account</a>
                }
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="container pt-3">
            <div class="alert-app ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container pt-3">
            <div class="alert-app err"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.Now.Year FlyLocal — Book smart, fly safe. Academic demo project.</span>
            <span><i class="bi bi-geo-alt"></i> Dhaka · Chattogram · Sylhet · Cox's Bazar · Dubai · Bangkok · Kuala Lumpur</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
